# Dashboard
WEB_GUI=true
WEB_PASSWORD=change-this-dashboard-password

# Persistent /data recorder. JSON is the local source of truth; /data optionally
# POSTs the compiled snapshot to a deployed Google Apps Script doPost webhook.
DATA_FILE=./data/spawner-data.json
DATA_WEBHOOK_URL=
DATA_WEBHOOK_TIMEOUT_MS=15000

# TPA / dump automation
TPA_MAIN_PLAYER=
TPA_TRUSTED_BOTS=BotOne,BotTwo
TPA_AUTO_DEFAULT=false
DUMP_HOME_COMMAND=/home stash
DUMP_MIN_TPA_GAP_MS=180000
DUMP_HIDDEN_MIN_MS=480000
DUMP_HIDDEN_MAX_MS=720000

# bot.js controls (see docs/bot-controls.md)
# Delay between /all-slow dispatches, in milliseconds. Default: 15000 (15s).
ALL_SLOW_DELAY_MS=15000
# Gap between /repeat runs, in milliseconds (an explicit delay token overrides it).
# Default: 2000 (2s) — the first run is immediate, this is the space between runs.
REPEAT_DELAY_MS=2000
# Refuse /all and /all-slow broadcasts that are not /commands, so a typo like
# "/all .server lifesteal" cannot make every bot say it in chat. Prefix with "!"
# to send chat deliberately ( /all !hello ). Default: true.
ALL_CHAT_GUARD=true
# Shuffle initial bot connection order. Set false to keep BOT_NAMES order.
RANDOMIZE_BOT_ORDER=true

# SSH terminal connection to the main host
WEB_TERMINAL_ENABLED=true
# Extra browser origins allowed to drive the dashboard when a reverse proxy or
# tunnel rewrites the Host header (full origin or host[:port], comma-separated).
# Modern browsers are accepted automatically via Sec-Fetch-Site; direct IP access
# and SSH tunnels to loopback need no configuration.
WEB_ALLOWED_ORIGINS=
SSH=true
SSH_HOST=OnlyAProgrammer
SSH_PORT=22
SSH_USER=your-ssh-username
SSH_PASSWORD=your-ssh-password
SSH_HOST_KEY_FINGERPRINT=SHA256:your-host-key-fingerprint
SSH_READY_TIMEOUT_MS=10000

# Discord and memory monitoring
DISCORD_NOTIFICATIONS=true
DISCORD_WEBHOOK_URL=
DISCORD_USER_ID=
DISCORD_MENTION_CRITICAL_ONLY=false
DISCORD_MIN_SEND_INTERVAL_MS=1200
DISCORD_EVENT_COOLDOWN_MS=60000
SERVER_RESTART_ALERT_COOLDOWN_MS=120000

MEMORY_WATCHDOG=true
MEMORY_CHECK_INTERVAL_MS=30000
MEMORY_AVAILABLE_WARN_PERCENT=15
MEMORY_AVAILABLE_CRITICAL_PERCENT=8
SWAP_WARN_PERCENT=10
SWAP_WARN_MIB=256
MEMORY_ALERT_COOLDOWN_MS=900000
MEMORY_RECOVERY_PERCENT=20

# Outbound proxy (applies to all bots unless overridden by a PROXY_GROUP below)
PROXY_HOST=
PROXY_PORT=1080
PROXY_TYPE=socks5

# ── AI Chat ───────────────────────────────────────────────────────────────────
# Enable AI chat for bots using FreeLLM API
AI_CHAT_ENABLED=false
AI_CHAT_INTERVAL_MIN_MS=40000   # Minimum interval between AI messages (40 seconds)
AI_CHAT_INTERVAL_MAX_MS=150000  # Maximum interval between AI messages (150 seconds)
AI_CHAT_WORD_LIMIT=8           # Maximum words per AI message (verified, not truncated)
AI_CHAT_MODEL=auto             # FreeLLM model ( /ai-chat model-set <model> changes it live )
# FreeLLM API credentials
FREE_LLM_API_KEY=your-free-llm-api-key-here
FREE_LLM_BASE_URL=http://localhost:3001/v1

# Text-file admission: one username per line in robot.txt; manual /start-login.
# Alternative passwords apply ONLY to robot.txt admissions.
LOGIN_PASSWORD_1=
LOGIN_PASSWORD_2=
ROBOT_CONNECT_DELAY_MS=5000
ROBOT_PASSWORD_DELAY_MS=1500
ROBOT_ADMISSION_TIMEOUT_MS=180000
# Admission routes include direct and all valid numbered proxy hosts,
# even empty _BOTS lists/gaps. Ordinary roster groups keep their existing rules.

# Managed roaming: /start-rtp reuses existing connected accounts only.
BOT_RTP_BOTS=
RTP_COMMAND=/rtp world world
RTP_INTERVAL_MS=34800
RTP_ARRIVAL_TIMEOUT_MS=30000
BASE_SCAN_RADIUS=192
BASE_SCAN_INTERVAL_MS=12000
BASE_ALERT_THRESHOLD=4
RTP_PAUSE_ON_BASE_MS=600000
FOOD_CHECK_INTERVAL_MS=5000
FOOD_EAT_THRESHOLD=18
PLAYER_PROXIMITY_RADIUS=32
PLAYER_PROXIMITY_INTERVAL_MS=5000
PLAYER_PROXIMITY_COOLDOWN_MS=300000
# Coordinates append to rtp-locations.txt; all discoveries stay local.

# Quiet Discord default: only strictly >40% offline after startup grace.
DISCORD_NOTIFICATIONS=true
DISCORD_VERBOSE_ALERTS=false
DISCORD_OFFLINE_REMINDER_MS=1800000
DISCORD_STARTUP_GRACE_MS=120000
# Keep existing DISCORD_WEBHOOK_URL / DISCORD_USER_ID credentials.
# DISCORD_OFFLINE_REMINDER_MS=0 disables reminder pings within an outage.

# ── Book auto-use (/use-book) ──────────────────────────────────────────────────
# Scan the open GUI (or the inventory) for a book, swap it into hotbar slot 1,
# select it and run /use && /use. Every step is BOOK_USE_DELAY_MS apart.
BOOK_ITEM_QUERY=book           # substring of the display, custom or registry name
BOOK_USE_DELAY_MS=200          # pause between each step so the server is never spammed
BOOK_AUTO=false                # true = run automatically whenever a GUI opens with a
                               # book in it; no book in the GUI — nothing happens at all

# Dedicated per-bot proxy groups (SOCKS5/HTTP). Add as many PROXY_GROUP_<N>_* sets as needed,
# starting at N=1 with no gaps. Bots not listed in any group use PROXY_HOST above (or connect
# directly if that is also empty).
# PROXY_GROUP_1_BOTS=Bot1,Bot2
# PROXY_GROUP_1_HOST=1.2.3.4
# PROXY_GROUP_1_PORT=1080
# PROXY_GROUP_1_TYPE=socks5
# PROXY_GROUP_2_BOTS=Bot3
# PROXY_GROUP_2_HOST=5.6.7.8
# PROXY_GROUP_2_PORT=1080
# PROXY_GROUP_2_TYPE=http

# Tor circuit rotation (/tor-newnym and the dashboard ⟳ tor button). With local Tor
# instances (scripts/restart-tor.sh: control port = SOCKS port + 1), a rotation signals
# NEWNYM and then staggered-reconnects the scoped bots so the new path takes effect now.
# Scope examples: /tor-newnym 2 (proxy group 2), /tor-newnym Bot3 (that bot's group),
# /tor-newnym default (ungrouped bots), /tor-newnym (everyone), --no-reconnect to only signal.
# TOR_CONTROL_PORTS=        # explicit control ports (empty = derive from local PROXY_* / PROXY_GROUP_*)
# TOR_ROTATE_DELAY_MS=5000  # delay between bot reconnects during a rotation

# Shard dashboard: staggered /shards balance probes (idle bots only).
# Rates are observed positive balance changes, not exact gross earnings:
# spending/transfers between samples can hide production. Two fresh samples
# are needed; stale/offline rates show a dash, not a made-up zero.
SHARD_SAMPLE_INTERVAL_MS=60000
# Shared command cooldown before crates; retry explicit cooldown replies twice.
CRATE_COMMAND_COOLDOWN_MS=6000
CRATE_WARP_SETTLE_MS=7000
# Longer crate session to accommodate server cooldowns; safety limit remains.
CRATE_CLICK_TIMEOUT_MS=180000
# Protocol/EPIPE/timeouts now back off too; retry count resets only after stability.
PROXY_RECONNECT_STAGGER_MS=5000
RECONNECT_STABLE_MS=120000
